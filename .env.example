# Case Closed Worker settings. No OpenAI API key or paid model API is used.
# For local preview, copy these setting names into the ignored .dev.vars file.
# For the hosted Site, configure them through Sites server settings instead.

# The loopback preview provides this mock verified identity.
# Replace it with the real owner's verified sign-in email for the hosted Site.
CASE_OWNER_EMAIL=seedy@sites.test

# The complete game runs without a model. Optional self-hosted Qwen: set local
# here AND select Local AI in Facilitator controls. See local-ai/README.md.
CASE_AI_PROVIDER=scripted

# Supply a unique random secret; it must match the protected relay configuration.
# Leave real values out of this tracked example and all browser code.
CASE_RELAY_TOKEN=

# The selected model and loopback URL are in .local-ai/relay.secrets,
# protected with Windows DPAPI. Start Local AI.cmd loads that configuration.
# Published recorded replays do not require the local server or relay.
